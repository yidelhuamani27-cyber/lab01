#include <stdio.h>

struct Proceso {
    int pid;
    char nombre[50];
    int prioridad;
};

struct Proceso* buscarMayorPrioridad(struct Proceso *procesos, int cantidad) {
    if (cantidad <= 0) return NULL;
    struct Proceso *ganador = &procesos[0];
    for (int i = 1; i < cantidad; i++) {
        if (procesos[i].prioridad < ganador->prioridad) {
            ganador = &procesos[i];
        }
    }
    return ganador;
}

